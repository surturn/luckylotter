# Copy to .env for local runs: cp .env.example .env
# .env is gitignored — real values never belong in the repo (NFR-6).

# HS256 signing key for admin JWTs. Must be at least 32 characters; the app
# refuses to start otherwise. Generate a real one per environment, e.g.
#   openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef

# Postgres credentials. Used by both the db and backend services.
POSTGRES_DB=lucklotter
POSTGRES_USER=lucklotter
POSTGRES_PASSWORD=lucklotter

# Offer delivery. With EMAIL_ENABLED=true the backend sends real SMTP mail to
# Mailpit, whose inbox is at http://localhost:8025 — nothing reaches a real
# person. Set false to fall back to the logging stub and run with no mail
# server at all. Pointing at a live provider (Brevo, SES) is only these vars
# plus MAIL_AUTH/MAIL_STARTTLS and credentials.
EMAIL_ENABLED=true
EMAIL_FROM=offers@lucklotter.test
MAIL_HOST=mailpit
MAIL_PORT=1025

# Demo data (§13). Seeds a business, an admin login, and a transaction history
# that flags customers on the first scan. Leave false for anything real — it is
# skipped anyway once a business exists.
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@lucklotter.test
SEED_ADMIN_PASSWORD=demo-password-123
